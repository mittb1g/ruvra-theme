{%- liquid
  assign discount = section.settings.discount | default: '[X]'
  assign marquee = section.settings.marquee_text | replace: '{descuento}', discount
-%}

<div class="ruvra-block ruvra-container">
  <div class="ruvra-kit">
    {%- if marquee != blank -%}
      <div class="ruvra-kit__marquee" aria-hidden="true">
        <div class="ruvra-kit__marquee-track">
          {%- for i in (1..2) -%}
            <div class="ruvra-kit__marquee-group">
              {%- assign parts = marquee | split: '|' -%}
              {%- for n in (1..3) -%}
                {%- for part in parts -%}
                  <span>{{ part | strip | escape }}</span><i class="ruvra-kit__sq"></i>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="ruvra-kit__body">
      <div class="ruvra-kit__copy">
        <p class="ruvra-kit__big" aria-hidden="true">-{{ discount | escape }}<span>%</span></p>
        {%- if section.settings.heading != blank -%}
          <h2 class="ruvra-kit__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="ruvra-kit__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        <div class="ruvra-kit__cta">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="ruvra-btn ruvra-btn--inverse">
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="ruvra-kit__cards ruvra-kit__cards--{{ section.blocks.size }}" role="list">
          {%- for block in section.blocks -%}
            <li class="ruvra-kit__card" {{ block.shopify_attributes }}>
              {%- if block.settings.product != blank -%}
                {%- render 'ruvra-card-product', card_product: block.settings.product, section_id: section.id -%}
              {%- else -%}
                <div class="ruvra-card">
                  <div class="ruvra-card__media ruvra-card__media--split">
                    <span class="ruvra-card__media-link">
                      {%- render 'ruvra-demo-image', demo: block.settings.demo_a, class: 'ruvra-card__img' -%}
                      {%- render 'ruvra-demo-image', demo: block.settings.demo_b, class: 'ruvra-card__img' -%}
                    </span>
                    <span class="ruvra-kit__plus" aria-hidden="true">+</span>
                    <span class="ruvra-badge">{{ 'ruvra.card.badge_combo' | t }}</span>
                  </div>
                  <h3 class="ruvra-card__title">{{ block.settings.title | escape }}</h3>
                  <div class="ruvra-price">
                    <span class="ruvra-price__current">$[PRECIO]</span>
                    <s class="ruvra-price__compare">$[ANTES]</s>
                  </div>
                  <p class="ruvra-installments">[N] cuotas<span class="ruvra-installments__long"> sin interés</span> de $[MONTO]</p>
                  <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="ruvra-btn ruvra-btn--sm ruvra-card__add">
                    {{- 'ruvra.card.view_combo' | t -}}
                  </a>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ruvra · Combos",
  "tag": "section",
  "class": "section-ruvra-promo",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "discount",
      "label": "Descuento (solo el número)",
      "default": "[X]",
      "info": "Se muestra gigante como \"-15%\". Tiene que coincidir con el descuento automático que configures en Shopify."
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Cinta animada",
      "default": "Armá tu kit | 2 o más productos | Ahorrá {descuento}%",
      "info": "Separá las frases con |. {descuento} se reemplaza por el número de arriba. Vacío = sin cinta."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Armá tu kit de ruta."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Llevando 2 o más productos, pagás menos. Se aplica solo en el carrito."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Ver combos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del botón"
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto combo",
          "info": "Creá el combo como producto en Shopify (con la etiqueta \"combo\" y 2 fotos). Se muestra con su precio, tachado y cuotas."
        },
        {
          "type": "header",
          "content": "Muestra (mientras no elijas producto)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre",
          "default": "Combo ruta: inflador + soporte"
        },
        {
          "type": "select",
          "id": "demo_a",
          "label": "Foto 1",
          "options": [
            {
              "value": "pad",
              "label": "Pad de carga"
            },
            {
              "value": "inflador",
              "label": "Inflador"
            },
            {
              "value": "soporte",
              "label": "Soporte"
            }
          ],
          "default": "inflador"
        },
        {
          "type": "select",
          "id": "demo_b",
          "label": "Foto 2",
          "options": [
            {
              "value": "pad",
              "label": "Pad de carga"
            },
            {
              "value": "inflador",
              "label": "Inflador"
            },
            {
              "value": "soporte",
              "label": "Soporte"
            }
          ],
          "default": "soporte"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ruvra · Combos",
      "blocks": [
        {
          "type": "combo",
          "settings": {
            "title": "Combo ruta: inflador + soporte",
            "demo_a": "inflador",
            "demo_b": "soporte"
          }
        },
        {
          "type": "combo",
          "settings": {
            "title": "Combo carga: pad + soporte",
            "demo_a": "pad",
            "demo_b": "soporte"
          }
        },
        {
          "type": "combo",
          "settings": {
            "title": "Combo completo: pad + inflador",
            "demo_a": "pad",
            "demo_b": "inflador"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
