<div class="ruvra-block ruvra-container">
  <div class="ruvra-promo">
    <div class="ruvra-promo__content">
      {%- if section.settings.badge != blank -%}
        <span class="ruvra-badge ruvra-badge--lg ruvra-badge--inverse">{{ section.settings.badge | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ruvra-promo__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="ruvra-promo__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="ruvra-btn ruvra-btn--inverse">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
    <div class="ruvra-promo__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1400',
            sizes: '(min-width: 1440px) 672px, (min-width: 990px) 50vw, 100vw',
            alt: section.settings.image.alt,
            class: 'ruvra-promo__img'
        }}
      {%- elsif section.settings.demo != 'none' -%}
        {%- render 'ruvra-demo-image', demo: section.settings.demo, class: 'ruvra-promo__img' -%}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'ruvra-promo__img ruvra-placeholder' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ruvra · Banner promo",
  "tag": "section",
  "class": "section-ruvra-promo",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "select",
      "id": "demo",
      "label": "Imagen de muestra",
      "info": "Solo se ve mientras no subas una imagen arriba.",
      "options": [
        { "value": "none", "label": "Ninguna" },
        { "value": "pad", "label": "Pad de carga" },
        { "value": "inflador", "label": "Inflador" },
        { "value": "soporte", "label": "Soporte" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Etiqueta",
      "default": "AHORRÁ [X]%"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Armá tu kit de ruta."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Llevando 2 o más productos, pagás menos. Se aplica solo en el carrito."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Ver combos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del botón"
    }
  ],
  "presets": [
    {
      "name": "ruvra · Banner promo"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
