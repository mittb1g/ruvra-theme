{%- liquid
  assign hero_product = section.settings.product
  assign button_url = section.settings.button_link | default: hero_product.url | default: routes.all_products_collection_url

  assign line_1 = section.settings.line_1 | strip
  assign line_2_options = section.settings.line_2 | split: '|'
  assign line_2 = line_2_options.first | strip
  assign slogan_full = line_1 | append: ' ' | append: line_2
-%}

<section class="ruvra-container ruvra-brand">
  <div class="ruvra-brand__panel">
    <span class="ruvra-brand__frame" aria-hidden="true"></span>
    <span class="ruvra-brand__corner ruvra-brand__corner--tl" aria-hidden="true"></span>
    <span class="ruvra-brand__corner ruvra-brand__corner--tr" aria-hidden="true"></span>
    <span class="ruvra-brand__corner ruvra-brand__corner--bl" aria-hidden="true"></span>
    <span class="ruvra-brand__corner ruvra-brand__corner--br" aria-hidden="true"></span>

    <div class="ruvra-brand__top">
      <span class="ruvra-brand__mark">{%- render 'ruvra-logo', height: 14 -%}</span>
      {%- if section.settings.caption_right != blank -%}
        <p class="ruvra-brand__caption">{{ section.settings.caption_right | escape }}</p>
      {%- endif -%}
    </div>

    <div class="ruvra-brand__body">
      <ruvra-typewriter
        class="ruvra-slogan"
        data-speed="{{ section.settings.speed }}"
        data-alternates="{{ section.settings.line_2 | escape }}"
      >
        <h1 class="ruvra-slogan__h" aria-label="{{ slogan_full | escape }}">
          {%- if line_1 != blank -%}
            {%- liquid
              assign ends_dot = false
              assign last_char = line_1 | slice: -1
              assign body = line_1
              if last_char == '.'
                assign ends_dot = true
                assign body_size = line_1.size | minus: 1
                assign body = line_1 | slice: 0, body_size
              endif
            -%}
            <span class="ruvra-slogan__line" aria-hidden="true" data-text="{{ line_1 | escape }}">
              {{- body | escape -}}
              {%- if ends_dot -%}<i class="ruvra-slogan__sq"></i>{%- endif -%}
            </span>
          {%- endif -%}
          {%- if line_2 != blank -%}
            {%- liquid
              assign ends_dot = false
              assign last_char = line_2 | slice: -1
              assign body = line_2
              if last_char == '.'
                assign ends_dot = true
                assign body_size = line_2.size | minus: 1
                assign body = line_2 | slice: 0, body_size
              endif
            -%}
            <span class="ruvra-slogan__line ruvra-slogan__line--muted" aria-hidden="true" data-text="{{ line_2 | escape }}">
              {{- body | escape -}}
              {%- if ends_dot -%}<i class="ruvra-slogan__sq"></i>{%- endif -%}
            </span>
          {%- endif -%}
        </h1>
      </ruvra-typewriter>

      {%- if section.settings.tagline != blank -%}
        <p class="ruvra-brand__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ button_url }}" class="ruvra-btn ruvra-btn--inverse">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.caption_left != blank -%}
      <p class="ruvra-brand__caption ruvra-brand__caption--bottom">{{ section.settings.caption_left | escape }}</p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'ruvra-typewriter.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "ruvra · Hero de marca",
  "tag": "div",
  "class": "section-ruvra-brand",
  "settings": [
    {
      "type": "text",
      "id": "line_1",
      "label": "Slogan, primera línea",
      "default": "Menos vueltas.",
      "info": "Un punto al final se dibuja como el cuadradito del logo."
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Slogan, segunda línea",
      "default": "Más camino.",
      "info": "Podés poner varias separadas por | y se escriben y borran en loop. Ej: Más camino.|Más carga.|Más tranquilo."
    },
    {
      "type": "select",
      "id": "speed",
      "label": "Velocidad de escritura",
      "options": [
        { "value": "slow", "label": "Lenta" },
        { "value": "normal", "label": "Normal" },
        { "value": "fast", "label": "Rápida" }
      ],
      "default": "normal"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Bajada",
      "default": "Accesorios automotrices para el uso de todos los días."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón (opcional)",
      "info": "Vacío = sin botón."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto del botón",
      "info": "El botón lleva a este producto. Si elegís un link abajo, tiene prioridad."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del botón (opcional)"
    },
    {
      "type": "text",
      "id": "caption_right",
      "label": "Leyenda arriba a la derecha",
      "default": "accesorios automotrices"
    },
    {
      "type": "text",
      "id": "caption_left",
      "label": "Leyenda abajo"
    }
  ],
  "presets": [
    {
      "name": "ruvra · Hero de marca"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
